# === Robot AI Server v3.5 — Environment Config ===

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# --- WiFi (ESP32 подключается к этой сети) ---
WIFI_SSID=TP-Link_208E
WIFI_PASSWORD=31267649

# --- Paths ---
MODELS_DIR=./models
AUDIO_CACHE_DIR=./audio_cache
CHARACTER_DIR=./character
MEMORY_DIR=./memory
DATASET_DIR=./datasets

# --- ПАМЯТЬ ---
# Краткосрочная: последние N реплик в RAM
SHORT_TERM_MEMORY_MAX=10
# Долгосрочная: Qdrant векторная БД (нужно установить Qdrant отдельно)
LONG_TERM_MEMORY_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- FINE-TUNING / LoRA ---
# LoRA адаптер для персонализации Сорена (опционально)
LORA_ENABLED=false
LORA_PATH=./models/soren_lora_v1.gguf
LORA_SCALE=1.0

# --- STT (faster-whisper) — только локальный ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM (llama.cpp) ---
LLM_MODEL_PATH=./models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_N_CTX=4096
LLM_N_THREADS=4
LLM_TEMPERATURE=0.6
LLM_REPEAT_PENALTY=1.15

# --- GitHub Models API ---
GITHUB_MODELS_KEY=ghp_xxx
GITHUB_MODELS_NAME=gpt-4o-mini

# --- TTS (Silero) ---
SILERO_SPEAKER=aidar
SILERO_PITCH_SEMITONES=1.5
SILERO_RATE=1.05

# --- FreeTTS (edge-tts) — бесплатный облачный TTS ---
FREETTS_VOICE=ru-RU-DmitryNeural
FREETTS_SPEED=1.0
FREETTS_PITCH=+15Hz

# --- Vision ---
YOLO_MODEL=./models/yolov8n.pt
ENABLE_POSE_TRACKING=true

# --- Audio ---
SAMPLE_RATE=16000
CHUNK_DURATION_MS=30
VAD_AGGRESSIVENESS=2
SILENCE_TIMEOUT_MS=1500

# --- OpenMP fix ---
KMP_DUPLICATE_LIB_OK=TRUE